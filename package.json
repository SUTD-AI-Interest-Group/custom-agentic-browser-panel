{
  "name": "lychee-ai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "dev:sandbox": "vite build --watch --mode development -c vite.sandbox.config.ts",
    "build": "tsc --noEmit && vite build && vite build -c vite.sandbox.config.ts",
    "build:sandbox": "vite build -c vite.sandbox.config.ts",
    "typecheck": "tsc --noEmit",
    "package": "bash scripts/package.sh",
    "store:assets": "node scripts/store-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@ai-sdk/openai": "^4.0.16",
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@cfworker/json-schema": "^4.1.1",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^7.0.22",
    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "marked": "^15.0.0",
    "marked-katex-extension": "^5.1.10",
    "pdfjs-dist": "^6.1.200",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
