                  "type": "text",
                  "id": "BNMei",
                  "name": "B",
                  "fill": "$s-gray",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "stopWhen halts at a step boundary, and during page control that means never mid-click — so a queued user message can never land between a gate and the action it guards.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-sans",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
