# No trailing slash: `node_modules/` matches a directory but NOT a symlink, and a
# git worktree symlinks node_modules at the main checkout. That gap let `git add -A`
# commit the symlink, which on merge REPLACED the real node_modules directory in the
# main checkout with a dangling link. Match both forms.
node_modules
dist/
*.local

# macOS Finder metadata
.DS_Store

# Claude Code: per-user settings and isolated worktrees stay out of the repo
.claude/settings.local.json
.claude/worktrees/

# Publicity: standalone Remotion motion-graphics project, not part of the extension
/publicity/

# Chrome Web Store upload packages built by scripts/package.sh
/lychee-ai-v*.zip

# Playwright MCP scratch traces (browser verification runs)
.playwright-mcp/
